{
  "scripts": {
    "check:ts": "tsc --noEmit",
    "offline": "serverless offline --noTimeout --reloadHandler",
    "dev": "concurrently -k \"tsc --noEmit --watch\" \"tsx watch src/local.ts\"",
    "deploy:dev": "serverless deploy --stage dev",
    "deploy:prod": "serverless deploy --stage prod",
    "logs:dev": "serverless logs -f api --stage dev -t",
    "logs:prod": "serverless logs -f api --stage prod -t",
    "remove:dev": "serverless remove --stage dev",
    "remove:prod": "serverless remove --stage prod",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:prod": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "test": "vitest",
    "test:run": "vitest run",
    "test:watch": "vitest --watch"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.3.0",
    "@prisma/client": "^7.2.0",
    "crypto": "^1.0.1",
    "express": "^4.22.1",
    "reflect-metadata": "^0.2.2",
    "serverless-http": "^4.0.0",
    "tsyringe": "^4.10.0",
    "typescript-eslint": "^8.53.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^25.0.8",
    "@types/supertest": "^7.2.0",
    "@typescript-eslint/eslint-plugin": "^8.53.0",
    "@typescript-eslint/parser": "^8.53.0",
    "concurrently": "^9.2.1",
    "dotenv": "^17.2.3",
    "esbuild": "^0.27.2",
    "eslint": "^9.39.2",
    "prisma": "^7.2.0",
    "serverless": "^3.40.0",
    "serverless-esbuild": "^1.57.0",
    "serverless-offline": "^13.9.0",
    "serverless-prune-plugin": "^2.1.0",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
