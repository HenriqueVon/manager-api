{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug (tsx watch local.ts)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "--inspect",
        "./node_modules/tsx/dist/cli.mjs",
        "watch",
        "src/local.ts"
      ],
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
