NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://user:pass@host:5432/dbname
SHADOW_DATABASE_URL=postgresql://user:pass@host:5432/shadow_dbname
# Optional. Connections the database pool of one process may open (1 to 20, default 2). In Lambda every
# container has its own pool, so the database sees containers x DB_POOL_MAX.
# DB_POOL_MAX=2
API_KEY=define-your-key
DOCS_ENABLED=false
AUTH_API_URL=https://www.example.com/v1/api
AUTH_API_KEY=
AUTH_CLIENT_SECRET=
AUTH_API_TIMEOUT_MS=
