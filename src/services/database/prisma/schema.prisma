generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum LedgerType {
  FIAT
  CRYPTO
  MIXED
}

model Ledger {
  id         String    @id @default(cuid())
  name       String    @unique @db.VarChar(100)
  type       LedgerType
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  
  @@map("ledgers")
}