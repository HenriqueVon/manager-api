generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum LedgerType {
  FIAT
  CRYPTO
  MIXED
}

model Ledger {
  id         String    @id @default(cuid())
  name       String    @unique @db.VarChar(100)
  type       LedgerType
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  
  financialBankAccounts     FinancialBankAccount[]
  financialFunds            FinancialFund[]
  financialCategories       FinancialCategory[]
  financialEntries          FinancialEntry[]
  financialFundTransactions FinancialFundTransaction[]
  @@map("ledgers")
}

model FinancialCurrency {
  id         String    @id @default(cuid())
  name       String    @unique @db.VarChar(100)
  symbol     String    @db.VarChar(10)
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  
  financialBankAccounts FinancialBankAccount[]
  financialFunds        FinancialFund[]
  @@map("financial_currencies")
}

model FinancialDescription {
  id          String    @id @default(cuid())
  description String    @unique @db.VarChar(100)  
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  
  financialEntries          FinancialEntry[]
  financialFundTransactions FinancialFundTransaction[]

  @@map("financial_descriptions")
}

model FinancialPaymentMethod {
  id         String    @id @default(cuid())
  name       String    @unique @db.VarChar(100)
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  
  @@map("financial_payment_methods")
}

enum FinancialBankAccountType {
  PERSONAL
  BUSINESS
}

model FinancialBankAccount {
  id                  String    @id @default(cuid())
  name                String    @unique @db.VarChar(100)
  type                FinancialBankAccountType
  balance             Decimal?  @db.Decimal(18, 2)
  financialCurrencyId String    @map("financial_currency_id")
  ledgerId            String    @map("ledger_id")  
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  
  financialCurrency   FinancialCurrency @relation(fields: [financialCurrencyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  ledger              Ledger            @relation(fields: [ledgerId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  financialFundTransactions FinancialFundTransaction[]

  @@index([financialCurrencyId])
  @@index([ledgerId])

  @@map("financial_bank_accounts")
}

model FinancialFund {
  id                  String    @id @default(cuid())
  name                String    @unique @db.VarChar(100)
  balance             Decimal?  @db.Decimal(18, 2)
  financialCurrencyId String    @map("financial_currency_id")
  ledgerId            String    @map("ledger_id")  
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  
  financialCurrency   FinancialCurrency @relation(fields: [financialCurrencyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  ledger              Ledger            @relation(fields: [ledgerId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  financialEntries          FinancialEntry[]
  financialFundTransactions FinancialFundTransaction[]

  @@index([financialCurrencyId])
  @@index([ledgerId])

  @@map("financial_funds")
}

enum FinancialCategoryType {
  INCOME
  EXPENSE
}

model FinancialCategory {
  id               String                 @id @default(cuid())
  ledgerId         String                 @map("ledger_id")
  parentCategoryId String?                @map("parent_category_id")
  name             String                 @db.VarChar(100)
  type             FinancialCategoryType
  balance          Decimal                @default(0) @db.Decimal(18, 2)
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")

  ledger                     Ledger              @relation(fields: [ledgerId], references: [id])  
  parentCategory             FinancialCategory?  @relation("FinancialCategoryHierarchy", fields: [parentCategoryId], references: [id])
  childCategories            FinancialCategory[] @relation("FinancialCategoryHierarchy")
  financialEntries           FinancialEntry[]
  financialFundTransactions FinancialFundTransaction[]

  @@unique([ledgerId, parentCategoryId, name])
  @@index([ledgerId])
  @@index([parentCategoryId])
  @@map("financial_categories")
}


enum FinancialEntryType {
  PAYABLE
  RECEIVABLE
}

model FinancialEntry {
  id                     String             @id @default(cuid())
  type                   FinancialEntryType
  dueDate                DateTime           @map("due_date")
  paymentDate            DateTime?          @map("payment_date")
  amount                 Decimal            @db.Decimal(18, 2)
  amountPaid             Decimal            @default(0) @map("amount_paid") @db.Decimal(18, 2)
  additionalDescription  String?            @map("additional_description")  @db.VarChar(100)
  isMonthly              Boolean            @default(false) @map("is_monthly")
  ledgerId               String             @map("ledger_id")
  financialDescriptionId String             @map("financial_description_id")
  financialFundId        String             @map("financial_fund_id")
  financialCategoryId    String             @map("financial_category_id")
  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")

  ledger                 Ledger               @relation(fields: [ledgerId], references: [id])  
  financialDescription   FinancialDescription @relation(fields: [financialDescriptionId], references: [id])
  financialFund          FinancialFund        @relation(fields: [financialFundId], references: [id])
  financialCategory      FinancialCategory    @relation(fields: [financialCategoryId], references: [id])

  @@index([ledgerId])
  @@index([financialDescriptionId])
  @@index([financialFundId])
  @@index([financialCategoryId])

  @@map("financial_entries")
}

model FinancialFundTransaction {
  id                     String             @id @default(cuid())  
  transactionDate        DateTime           @map("transaction_date") @db.Date  
  amountCredit           Decimal            @default(0) @map("amount_credit") @db.Decimal(18, 2)
  amountDebit            Decimal            @default(0) @map("amount_debit") @db.Decimal(18, 2)  
  additionalDescription  String?            @map("additional_description") @db.VarChar(100)  
  ledgerId               String             @map("ledger_id")
  financialDescriptionId String             @map("financial_description_id")
  financialFundId        String             @map("financial_fund_id")
  financialCategoryId    String             @map("financial_category_id")
  financialBankAccountId String             @map("financial_bank_account_id")

  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")

  ledger                 Ledger               @relation(fields: [ledgerId], references: [id])  
  financialDescription   FinancialDescription @relation(fields: [financialDescriptionId], references: [id])
  financialFund          FinancialFund        @relation(fields: [financialFundId], references: [id])
  financialCategory      FinancialCategory    @relation(fields: [financialCategoryId], references: [id])
  financialBankAccount   FinancialBankAccount @relation(fields: [financialBankAccountId], references: [id])

  @@index([ledgerId])
  @@index([financialDescriptionId])
  @@index([financialFundId])
  @@index([financialCategoryId])
  @@index([financialBankAccountId])

  @@map("financial_fund_transactions")
}
